+name: CI
+
+on:
+  push:
+  pull_request:
+
+jobs:
+  tests:
+    runs-on: ubuntu-latest
+    strategy:
+      fail-fast: false
+      matrix:
+        python-version: ["3.9", "3.12"]
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: ${{ matrix.python-version }}
+          cache: pip
+          cache-dependency-path: Pipeline/requirements-dev.txt
+      - name: Install dependencies
+        run: pip install -r Pipeline/requirements-dev.txt
+      - name: Run tests (unit + end-to-end on sample_data)
+        run: python -m pytest Pipeline/tests -v
+
+  no-private-data:
+    # Fails the build if anything that looks like chat data is tracked by
+    # git. The data directory lives outside this repo, so this should
+    # never trigger -- it exists to catch a mistake before it's public.
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Check tracked files
+        run: python3 Pipeline/tools_dev/check_no_private_data.py
