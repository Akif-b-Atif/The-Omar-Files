+    new = (
+        "13-Dec-2024, 03:20 - Alice Smith: lol\n"
+        "13-Dec-2024, 03:20 - Alice Smith: lol\n"
+    )
+    texts, added, dup, _ = _merge(archive, new)
+    assert added == 2
+    assert dup == 0
+    assert texts.count("13-Dec-2024, 03:20 - Alice Smith: lol") == 2
+
