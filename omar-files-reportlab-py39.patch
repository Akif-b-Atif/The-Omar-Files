From 67ab9fb39f4221ac2b6e791c01ef59ecf3ebf269 Mon Sep 17 00:00:00 2001
From: Akif-b-Atif <akif.b.atif@gmail.com>
Date: Sun, 1 Nov 2026 21:08:24 +0000
Subject: [PATCH] requirements: keep reportlab on 4.x for Python 3.9

reportlab 5.x raises ImportError on Python 3.9 but doesn't declare the
requirement in its metadata, so pip installs it there and the PDF step
crashes (this also broke the 3.9 CI job's tests). Add an environment marker.
---
 Pipeline/requirements.txt | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/Pipeline/requirements.txt b/Pipeline/requirements.txt
index 75e5ea7..1c886d6 100644
--- a/Pipeline/requirements.txt
+++ b/Pipeline/requirements.txt
@@ -11,4 +11,8 @@
 pandas>=2.0
 numpy>=1.24
 matplotlib>=3.7
-reportlab>=4.0
+# reportlab 5.x refuses to import on Python 3.9 (it needs 3.10+) without
+# declaring that in its package metadata, so pip would happily install it
+# there and the PDF step would then crash. Stay on 4.x for 3.9.
+reportlab>=4.0,<5; python_version < "3.10"
+reportlab>=4.0; python_version >= "3.10"
-- 
2.43.0

